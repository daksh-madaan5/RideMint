rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function ownsExistingListing() {
      return isOwner(resource.data.ownerId);
    }

    function validImage(image) {
      return image is map
        && image.keys().hasOnly(['url', 'publicId', 'assetId', 'width', 'height', 'format'])
        && image.url is string
        && image.publicId is string
        && image.assetId is string
        && image.width is int
        && image.height is int
        && image.format is string;
    }

    function validImages(images) {
      return images is list
        && images.size() >= 1
        && images.size() <= 4
        && validImage(images[0])
        && (images.size() < 2 || validImage(images[1]))
        && (images.size() < 3 || validImage(images[2]))
        && (images.size() < 4 || validImage(images[3]));
    }

    function validListingValues(data) {
      return data.ownerId is string
        && data.ownerSnapshot is map
        && data.ownerSnapshot.keys().hasOnly(['displayName', 'photoURL', 'emailVerified'])
        && data.ownerSnapshot.displayName is string
        && data.ownerSnapshot.photoURL is string
        && data.ownerSnapshot.emailVerified is bool
        && data.make is string
        && data.make.size() >= 2
        && data.model is string
        && data.model.size() >= 1
        && data.year is int
        && data.year >= 1990
        && data.year <= 2100
        && data.category in ['Hatchback', 'Sedan', 'SUV', 'MUV']
        && data.city in ['Bengaluru', 'Hyderabad', 'Mumbai', 'Delhi NCR', 'Pune', 'Chennai', 'Bhubaneswar']
        && data.transmission in ['Manual', 'Automatic']
        && data.fuelType in ['Petrol', 'Diesel', 'Electric', 'CNG']
        && data.seats is int
        && data.seats >= 2
        && data.seats <= 10
        && data.pricePerDay is number
        && data.pricePerDay > 0
        && data.pricePerDay <= 100000
        && data.description is string
        && data.description.size() >= 80
        && data.description.size() <= 1200
        && validImages(data.images)
        && data.listingStatus in ['pending', 'approved', 'rejected', 'inactive']
        && data.availabilityStatus in ['available', 'unavailable'];
    }

    function validListingCreate() {
      return request.resource.data.keys().hasOnly([
          'ownerId', 'ownerSnapshot', 'make', 'model', 'year', 'category',
          'city', 'transmission', 'fuelType', 'seats', 'pricePerDay',
          'description', 'images', 'listingStatus', 'availabilityStatus',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.listingStatus == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validListingValues(request.resource.data);
    }

    function validListingUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let availabilityOnly = changed.hasOnly(['availabilityStatus', 'updatedAt'])
        && request.resource.data.listingStatus == resource.data.listingStatus;
      let deactivateOnly = resource.data.listingStatus in ['pending', 'approved', 'rejected']
        && changed.hasOnly(['listingStatus', 'updatedAt'])
        && request.resource.data.listingStatus == 'inactive';
      let reactivateOnly = resource.data.listingStatus == 'inactive'
        && changed.hasOnly(['listingStatus', 'availabilityStatus', 'updatedAt'])
        && request.resource.data.listingStatus == 'pending'
        && request.resource.data.availabilityStatus == 'available';
      let resubmitOrEdit = changed.hasOnly([
          'make', 'model', 'year', 'category', 'city', 'transmission',
          'fuelType', 'seats', 'pricePerDay', 'description', 'images',
          'availabilityStatus', 'listingStatus', 'updatedAt'
        ])
        && resource.data.listingStatus != 'inactive'
        && request.resource.data.listingStatus == 'pending';

      return request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ownerSnapshot == resource.data.ownerSnapshot
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validListingValues(request.resource.data)
        && (availabilityOnly || deactivateOnly || reactivateOnly || resubmitOrEdit);
    }

    function validAdminModeration() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.listingStatus == 'pending'
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ownerSnapshot == resource.data.ownerSnapshot
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.listingStatus in ['approved', 'rejected']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.moderatedAt == request.time
        && request.resource.data.moderatedBy == request.auth.uid
        && (request.resource.data.listingStatus == 'approved'
          ? request.resource.data.rejectionReason == null
          : request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() > 0
            && request.resource.data.rejectionReason.size() <= 500)
        && changed.hasOnly([
          'listingStatus', 'rejectionReason', 'moderatedAt',
          'moderatedBy', 'updatedAt'
        ]);
    }

    function publicListing() {
      return resource.data.listingStatus == 'approved'
        && resource.data.availabilityStatus == 'available';
    }

    match /vehicleListings/{listingId} {
      allow read: if publicListing() || ownsExistingListing() || isAdmin();
      allow create: if isSignedIn() && validListingCreate();
      allow update: if (ownsExistingListing() && validListingUpdate())
        || (isAdmin() && validAdminModeration());
      allow delete: if false;
    }

    function validUserProfileCreate(userId) {
      return request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'photo', 'role', 'favorites', 'createdAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.photo is string
        && request.resource.data.favorites is list
        && request.resource.data.createdAt == request.time;
    }

    function validOwnProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['name', 'photo', 'avatarUrl', 'favorites'])
        && (!changed.hasAny(['name'])
          || (request.resource.data.name is string
            && request.resource.data.name.size() >= 1
            && request.resource.data.name.size() <= 80))
        && (!changed.hasAny(['photo']) || request.resource.data.photo is string)
        && (!changed.hasAny(['avatarUrl']) || request.resource.data.avatarUrl is string)
        && (!changed.hasAny(['favorites']) || request.resource.data.favorites is list);
    }

    function validAdminRoleUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['role'])
        && request.resource.data.role in ['user', 'admin'];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && validUserProfileCreate(userId);
      allow update: if (isOwner(userId) && validOwnProfileUpdate())
        || (isAdmin() && validAdminRoleUpdate());
      allow delete: if false;
    }

    match /cars/{carId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    function ownsBooking() {
      return isOwner(resource.data.userId);
    }

    function validCustomerCancellation() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.status in ['pending', 'confirmed']
        && changed.hasOnly(['status'])
        && request.resource.data.status == 'cancelled';
    }

    function validAdminBookingUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['status'])
        && request.resource.data.status in ['pending', 'confirmed', 'completed', 'cancelled'];
    }

    match /bookings/{bookingId} {
      allow read: if ownsBooking() || isAdmin();
      // Booking creation remains blocked until dates, availability, and prices
      // are established by trusted backend code.
      allow create: if false;
      allow update: if (ownsBooking() && validCustomerCancellation())
        || (isAdmin() && validAdminBookingUpdate());
      allow delete: if false;
    }

    function validReviewSnapshot(snapshot) {
      return snapshot is map
        && snapshot.keys().hasOnly(['name', 'avatar'])
        && snapshot.name is string
        && (snapshot.avatar is string || snapshot.avatar == null);
    }

    function validReviewCreate() {
      return request.resource.data.keys().hasOnly([
          'userId', 'carId', 'rating', 'comment', 'userSnapshot', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.carId is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 10
        && request.resource.data.comment.size() <= 2000
        && validReviewSnapshot(request.resource.data.userSnapshot)
        && request.resource.data.createdAt == request.time;
    }

    function validOwnReviewUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['rating', 'comment', 'userSnapshot'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 10
        && request.resource.data.comment.size() <= 2000
        && validReviewSnapshot(request.resource.data.userSnapshot);
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && validReviewCreate();
      allow update: if isOwner(resource.data.userId) && validOwnReviewUpdate();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
